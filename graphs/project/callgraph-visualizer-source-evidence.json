{
  "schemaVersion": "0.4",
  "projectId": "callgraph-visualizer",
  "categoryId": "project",
  "category": "项目自身",
  "title": "Callgraph Visualizer validation and source evidence",
  "description": "展示当前工作区中，一张调用图激活后，前端如何启动结构与源码校验，并为当前节点或连线请求受限源码预览。后端始终从已加载图中解析 projectId 和目标位置，再把相对路径限制在配置根目录内；缓存、不可定位目标和请求错误形成清晰分支，不会绕过证据边界读取任意文件。",
  "root": "evidence.activate-graph",
  "phases": [
    {
      "id": "activate-graph",
      "title": "激活一张图谱",
      "summary": "建立图状态并先渲染可读界面，随后校验整图；首次选中的根节点也会触发源码预览。",
      "order": 1
    },
    {
      "id": "validate-evidence",
      "title": "校验整图证据",
      "summary": "重新读取图谱、解析项目根目录并检查结构关系和每个精确源码位置，最终形成页面校验徽标。",
      "order": 2
    },
    {
      "id": "request-preview",
      "title": "请求目标源码",
      "summary": "当前节点或边先经过可定位性和缓存判断；只有需要新数据时才发送预览请求。",
      "order": 3
    },
    {
      "id": "resolve-boundary",
      "title": "解析可信文件边界",
      "summary": "服务端只接受图 slug 和目标 ID，从图内取相对路径并确认规范化结果仍位于项目根目录。",
      "order": 4
    },
    {
      "id": "read-source",
      "title": "读取受限源码",
      "summary": "文件预览器执行大小、普通文件、UTF-8、二进制和行数限制，并按目标范围或整文件模式返回文本。",
      "order": 5
    },
    {
      "id": "show-evidence",
      "title": "展示或解释结果",
      "summary": "命中缓存或成功读取时更新源码工作台；不可定位和请求异常则显示原因，避免把缺失证据伪装为可验证关系。",
      "order": 6
    }
  ],

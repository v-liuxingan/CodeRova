{
  "schemaVersion": "0.4",
  "projectId": "callgraph-visualizer",
  "categoryId": "project",
  "category": "项目自身",
  "title": "Callgraph Visualizer interactive exploration loop",
  "description": "展示当前工作区中，调用图激活、节点或边点击以及调用步进如何汇入同一个 GraphState 更新循环。状态层从真实节点和边计算可见结构与上下游焦点，loop-back 不扩张遍历；渲染器重建图元但保留当前视口。独立场景页只通过普通链接跳转，不参与本图的交互状态。",
  "root": "interaction.activate-graph",
  "phases": [
    {
      "id": "initialize-view",
      "title": "建立探索工作区",
      "summary": "完整图和布局进入 GraphState、调用步进器与 SVG 画布，作为工作台交互的数据来源。",
      "order": 1
    },
    {
      "id": "choose-context",
      "title": "选择阅读上下文",
      "summary": "用户直接点击真实节点或边来选择阅读目标；选择保留当前视口，不触发跨页面状态同步。",
      "order": 2
    },
    {
      "id": "update-state",
      "title": "更新选择状态",
      "summary": "选择同步到调用游标和 GraphState，连续上下游点击保留有效锚点，其他选择重置锚点。",
      "order": 3
    },
    {
      "id": "derive-focus",
      "title": "推导可见与高亮链路",
      "summary": "状态层应用折叠、隐藏和类型筛选，再从真实关系计算节点或边的上下游焦点。",
      "order": 4
    },
    {
      "id": "render-result",
      "title": "重建可视化结果",
      "summary": "叙事布局计算主干、分支与回环位置，SVG 重新生成边和节点并恢复之前的画布变换。",
      "order": 5
    },
    {
      "id": "continue-reading",
      "title": "沿调用链继续阅读",
      "summary": "步进器根据当前游标和可见关系选择调用位置或下一节点，结果再次进入同一个状态更新回环。",
      "order": 6
    }
  ],

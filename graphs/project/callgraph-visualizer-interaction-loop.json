{
  "schemaVersion": "0.4",
  "projectId": "callgraph-visualizer",
  "categoryId": "project",
  "category": "项目自身",
  "title": "Callgraph Visualizer interactive exploration loop",
  "description": "展示图谱激活后，场景拓扑、节点或边点击以及调用步进如何汇入同一个 GraphState 更新循环。状态层从真实节点和边计算可见结构与上下游焦点，明确排除 loop-back 对遍历的扩张；渲染器在叙事布局上重建图元但恢复原视口，只有从场景拓扑显式下钻时才居中目标阶段。",
  "sourceRevision": "58b58f7d61a20cceda6572c13d47f0e2837497a4",
  "root": "interaction.activate-graph",
  "phases": [
    {
      "id": "initialize-view",
      "title": "建立探索工作区",
      "summary": "完整图和布局进入状态、场景拓扑、调用步进器与 SVG 画布，形成后续交互共享的单一数据来源。",
      "order": 1
    },
    {
      "id": "choose-context",
      "title": "选择阅读上下文",
      "summary": "用户可以从场景拓扑显式下钻，或直接点击节点和边；只有场景下钻会主动居中。",
      "order": 2
    },
    {
      "id": "update-state",
      "title": "更新选择状态",
      "summary": "选择同步到调用游标和 GraphState，连续上下游点击保留有效锚点，其他选择重置锚点。",
      "order": 3
    },
    {
      "id": "derive-focus",
      "title": "推导可见与高亮链路",
      "summary": "状态层应用折叠、隐藏和类型筛选，再从真实关系计算节点或边的上下游焦点与阶段焦点。",
      "order": 4
    },
    {
      "id": "render-result",
      "title": "重建可视化结果",
      "summary": "叙事布局计算主干、分支与回环位置，SVG 重新生成边和节点并恢复之前的画布变换。",
      "order": 5
    },
    {
      "id": "continue-reading",
      "title": "沿调用链继续阅读",
      "summary": "步进器根据当前游标和可见关系选择调用位置或下一节点，结果再次进入同一个状态更新回环。",
      "order": 6
    }
  ],

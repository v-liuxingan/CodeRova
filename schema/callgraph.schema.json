{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.callgraph/callgraph.schema.json",
  "title": "Source Callgraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "title",
    "root",
    "nodes",
    "edges"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "0.2",
        "0.3",
        "0.4",
        "0.5"
      ]
    },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Stable id resolved through callgraph.projects.json"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "categoryId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Stable physical catalog directory id such as overview, session, tools, or context"
    },
    "category": {
      "type": "string",
      "maxLength": 40,
      "description": "Human-readable catalog group; blank or omitted graphs fall back to Uncategorized"
    },
    "description": {
      "type": "string"
    },
    "sourceRevision": {
      "type": [
        "string",
        "null"
      ]
    },
    "analysis": {
      "$ref": "#/$defs/analysis"
    },
    "phases": {
      "type": "array",
      "description": "Ordered user-facing scenario phases; nodes opt in through phaseId",
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "root": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {}
    },
    "edges": {
      "type": "array",
      "items": {}
    }
  },
  "$defs": {
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "scope",
        "maxDepth",
        "requestBudget",
        "queriedNodes",
        "pendingNodes",
        "issues"
      ],
      "properties": {
        "provider": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 0
        },
        "requestBudget": {
          "type": "integer",
          "minimum": 1
        },
        "queriedNodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "prunedNodeIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "pendingNodes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "order"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the configured source root"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "sourceFile",
        "line",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "phaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Optional user-facing scenario phase membership"
        },
        "kind": {
          "enum": [
            "function",
            "method",
            "closure",
            "trait",
            "struct",
            "module",
            "process",
            "remote-service"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "crate": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "sourceFile": {
          "$ref": "#/$defs/sourcePath"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "state": {
          "enum": [
            "expanded",
            "collapsed",
            "hidden"
          ],
          "default": "expanded"
        },
        "symbol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ownerKind",
            "ownerName"
          ],
          "properties": {
            "ownerKind": {
              "type": "string"
            },
            "ownerName": {
              "type": "string"
            },
            "modifiers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "target",
        "relation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "relation": {
          "enum": [
            "direct",
            "callback",
            "trait-dispatch",
            "spawn",
            "remote",
            "async-boundary",
            "data-flow",
            "static-call"
          ]
        },
        "flowKind": {
          "enum": [
            "normal",
            "branch",
            "fallback",
            "merge",
            "loop-back",
            "loop-exit"
          ],
          "default": "normal",
          "description": "Runtime control-flow role, independent from the call mechanism in kind"
        },
        "condition": {
          "type": "string",
          "description": "Human-readable branch or loop condition"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "Known execution order among sequential outgoing calls from the same caller"
        },
        "label": {
          "type": "string"
        },
        "callSiteStatus": {
          "enum": [
            "exact",
            "virtual-node",
            "omitted-nodes"
          ],
          "default": "exact"
        },
        "callSiteNote": {
          "type": "string"
        },
        "sourceFile": {
          "$ref": "#/$defs/sourcePath"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "confidenceScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "file",
            "line"
          ],
          "properties": {
            "callSiteStatus": {
              "const": "exact"
            }
          }
        },
        {
          "required": [
            "callSiteStatus",
            "callSiteNote"
          ],
          "properties": {
            "callSiteStatus": {
              "enum": [
                "virtual-node",
                "omitted-nodes"
              ]
            },
            "callSiteNote": {
              "type": "string",
              "minLength": 1
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "line"
                ]
              }
            ]
          }
        }
      ]
    },
    "nodeLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "file",
        "line",
        "role"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "phaseId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Optional user-facing scenario phase membership"
        },
        "kind": {
          "enum": [
            "function",
            "method",
            "closure",
            "trait",
            "struct",
            "module",
            "process",
            "remote-service"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "crate": {
          "type": "string"
        },
        "module": {
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/sourcePath"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "state": {
          "enum": [
            "expanded",
            "collapsed",
            "hidden"
          ],
          "default": "expanded"
        },
        "symbol": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ownerKind",
            "ownerName"
          ],
          "properties": {
            "ownerKind": {
              "type": "string"
            },
            "ownerName": {
              "type": "string"
            },
            "modifiers": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "edgeLegacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "direct",
            "callback",
            "trait-dispatch",
            "spawn",
            "remote",
            "async-boundary",
            "data-flow",
            "static-call"
          ]
        },
        "flowKind": {
          "enum": [
            "normal",
            "branch",
            "fallback",
            "merge",
            "loop-back",
            "loop-exit"
          ],
          "default": "normal",
          "description": "Runtime control-flow role, independent from the call mechanism in kind"
        },
        "condition": {
          "type": "string",
          "description": "Human-readable branch or loop condition"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "description": "Known execution order among sequential outgoing calls from the same caller"
        },
        "label": {
          "type": "string"
        },
        "callSiteStatus": {
          "enum": [
            "exact",
            "virtual-node",
            "omitted-nodes"
          ],
          "default": "exact"
        },
        "callSiteNote": {
          "type": "string"
        },
        "file": {
          "$ref": "#/$defs/sourcePath"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "description": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 1
        }
      },
      "oneOf": [
        {
          "required": [
            "file",
            "line"
          ],
          "properties": {
            "callSiteStatus": {
              "const": "exact"
            }
          }
        },
        {
          "required": [
            "callSiteStatus",
            "callSiteNote"
          ],
          "properties": {
            "callSiteStatus": {
              "enum": [
                "virtual-node",
                "omitted-nodes"
              ]
            },
            "callSiteNote": {
              "type": "string",
              "minLength": 1
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "file"
                ]
              },
              {
                "required": [
                  "line"
                ]
              }
            ]
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "0.5"
          }
        }
      },
      "then": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/$defs/node"
            }
          },
          "edges": {
            "items": {
              "$ref": "#/$defs/edge"
            }
          }
        }
      },
      "else": {
        "properties": {
          "nodes": {
            "items": {
              "$ref": "#/$defs/nodeLegacy"
            }
          },
          "edges": {
            "items": {
              "$ref": "#/$defs/edgeLegacy"
            }
          }
        }
      }
    }
  ]
}

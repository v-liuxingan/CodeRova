{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.callgraph/callgraph.schema.json",
  "title": "Source Callgraph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "title", "root", "nodes", "edges"],
  "properties": {
    "schemaVersion": { "const": "0.2" },
    "projectId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Stable id resolved through callgraph.projects.json"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "sourceRevision": { "type": ["string", "null"] },
    "root": { "type": "string", "minLength": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" }
    }
  },
  "$defs": {
    "sourcePath": {
      "type": "string",
      "minLength": 1,
      "description": "Path relative to the configured source root"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label", "file", "line", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["function", "method", "closure", "trait", "struct", "module", "process", "remote-service"]
        },
        "label": { "type": "string", "minLength": 1 },
        "crate": { "type": "string" },
        "module": { "type": "string" },
        "file": { "$ref": "#/$defs/sourcePath" },
        "line": { "type": "integer", "minimum": 1 },
        "endLine": { "type": ["integer", "null"], "minimum": 1 },
        "role": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "state": { "enum": ["expanded", "collapsed", "hidden"], "default": "expanded" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["direct", "callback", "trait-dispatch", "spawn", "remote", "async-boundary", "data-flow"]
        },
        "label": { "type": "string" },
        "callSiteStatus": {
          "enum": ["exact", "virtual-node", "omitted-nodes"],
          "default": "exact"
        },
        "callSiteNote": { "type": "string" },
        "file": { "$ref": "#/$defs/sourcePath" },
        "line": { "type": "integer", "minimum": 1 },
        "description": { "type": "string" },
        "evidence": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 }
      },
      "oneOf": [
        {
          "required": ["file", "line"],
          "properties": {
            "callSiteStatus": { "const": "exact" }
          }
        },
        {
          "required": ["callSiteStatus", "callSiteNote"],
          "properties": {
            "callSiteStatus": { "enum": ["virtual-node", "omitted-nodes"] },
            "callSiteNote": { "type": "string", "minLength": 1 }
          },
          "not": {
            "anyOf": [
              { "required": ["file"] },
              { "required": ["line"] }
            ]
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.callgraph/layout.schema.json",
  "title": "Callgraph Manual Layout",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "graph", "positions"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "graph": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "positions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vertical": { "$ref": "#/$defs/orientation" },
        "horizontal": { "$ref": "#/$defs/orientation" }
      }
    }
  },
  "$defs": {
    "orientation": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["x", "y"],
        "properties": {
          "x": { "type": "number", "minimum": -1000000, "maximum": 1000000 },
          "y": { "type": "number", "minimum": -1000000, "maximum": 1000000 }
        }
      }
    }
  }
}

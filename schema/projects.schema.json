{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.callgraph/projects.schema.json",
  "title": "Callgraph Project Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projects"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "root"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "description": "Absolute path or path relative to this configuration file"
          }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent execution sequence scene",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "title",
    "summary",
    "project",
    "scope",
    "participants",
    "body",
    "evidence"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "revision"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]+$",
          "description": "Optional project catalog id for local source verification"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startEnd",
        "boundary"
      ],
      "properties": {
        "startEnd": {
          "type": "string",
          "minLength": 1
        },
        "boundary": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "participants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/participant"
      }
    },
    "body": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1
    },
    "reading": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "text"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "callgraph": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$"
    },
    "theme": {
      "type": "string",
      "enum": [
        "editorial",
        "halo",
        "aether",
        "signal"
      ]
    }
  },
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "symbol"
      ],
      "properties": {
        "file": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1,
          "description": "Optional literal excerpt expected in the referenced line range"
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "claim",
        "locations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "source",
            "inferred"
          ],
          "description": "Author classification; source location validity does not prove the claim"
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "from",
        "to",
        "kind",
        "label"
      ],
      "properties": {
        "type": {
          "const": "message"
        },
        "from": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "to": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$"
        },
        "kind": {
          "enum": [
            "call",
            "return",
            "async"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "text"
      ],
      "properties": {
        "type": {
          "const": "note"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "over": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9_-]+$"
          }
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "condition",
        "body"
      ],
      "properties": {
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "condition",
        "body"
      ],
      "properties": {
        "type": {
          "const": "loop"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "opt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "condition",
        "body"
      ],
      "properties": {
        "type": {
          "const": "opt"
        },
        "condition": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "alt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "branches"
      ],
      "properties": {
        "type": {
          "const": "alt"
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    },
    "par": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "branches"
      ],
      "properties": {
        "type": {
          "const": "par"
        },
        "branches": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/branch"
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/message"
        },
        {
          "$ref": "#/$defs/note"
        },
        {
          "$ref": "#/$defs/loop"
        },
        {
          "$ref": "#/$defs/opt"
        },
        {
          "$ref": "#/$defs/alt"
        },
        {
          "$ref": "#/$defs/par"
        }
      ]
    }
  }
}

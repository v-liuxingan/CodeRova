{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.callgraph/architecture-scenario.schema.json",
  "title": "Architecture Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "title", "goal", "participants", "steps", "links"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "title": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "participants": { "type": "array", "items": { "$ref": "#/$defs/participant" } },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["application", "broker", "external-system", "user"] },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "participantId", "kind", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "participantId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["entry", "operation", "message", "handler", "decision", "retry", "outcome", "external"] },
        "label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "drilldowns": { "type": "array", "items": { "$ref": "#/$defs/drilldown" } }
      }
    },
    "drilldown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projectId", "graphSlug", "targetIds", "purpose"],
      "properties": {
        "projectId": { "$ref": "#/$defs/id" },
        "graphSlug": { "$ref": "#/$defs/id" },
        "targetIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "purpose": { "type": "string", "minLength": 1 }
      }
    },
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from", "to", "kind"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["call", "request", "publish", "route", "deliver", "consume", "reply", "retry", "timeout", "compensate", "state-dependency"] },
        "label": { "type": "string" },
        "summary": { "type": "string" },
        "condition": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1, "default": 1 }
      }
    }
  }
}
